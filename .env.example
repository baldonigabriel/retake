# Copy to .env.local and fill in. Never commit real values.
# Production values go in Vercel › Project › Settings › Environment Variables
# (see docs/DEPLOY.md). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Postgres (Neon). Direct connection: used by drizzle-kit migrations and scripts.
DATABASE_URL=

# Pooled connection (Neon "-pooler" host). The app runtime uses it when set.
# Required in production (Vercel); optional locally.
DATABASE_URL_POOLED=

# Better Auth: secret with 32+ chars, and the public base URL of the app
# (http://localhost:3000 locally, https://<your-app>.vercel.app in production).
# Also used for links in the Discord cards and invite links.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Discord OAuth app (discord.com/developers › your app › OAuth2).
# Redirect: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google OAuth app (console.cloud.google.com › APIs e serviços › Credenciais).
# Redirect: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HenrikDev API key (Basic, server-only)
HENRIK_API_KEY=

# Shared secret for POST /api/cron/sync (Authorization: Bearer ...), 16+ chars
CRON_SECRET=

# AES-256-GCM key for secrets at rest (Discord webhook URLs): base64 of 32 bytes.
# Changing it makes saved webhooks unreadable (owners must paste them again).
ENCRYPTION_KEY=

# Weekly summary text (server-only, both optional). Order: Gemini → Groq →
# rule-based text, so the summary always goes out, even with no keys.
# Gemini: aistudio.google.com/apikey (free tier). Groq: console.groq.com/keys (free plan).
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash-lite, openai/gpt-oss-120b).
# GEMINI_MODEL=
# GROQ_MODEL=
