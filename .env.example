# Copy to .env.local and fill in. Never commit real values.

# Postgres (Neon). Direct connection: used by Drizzle, migrations and the sync
DATABASE_URL=

# Pooled connection (Neon pooler), reserved for the Vercel runtime
DATABASE_URL_POOLED=

# Better Auth (Phase 2): secret with 32+ chars, and the app base URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Discord OAuth app (Phase 2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# HenrikDev API key (Basic, server-only)
HENRIK_API_KEY=

# Shared secret for POST /api/cron/sync (Authorization: Bearer ...)
CRON_SECRET=

# Key used to encrypt Discord webhook URLs at rest (32+ chars)
WEBHOOK_ENCRYPTION_KEY=

# Public base URL (safe to expose to the browser)
NEXT_PUBLIC_APP_URL=
